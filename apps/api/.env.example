ENVIRONMENT=development

# NeonDB PostgreSQL — use the pooled connection string in production, direct for migrations
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pfs_erp

JWT_SECRET=
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=1440

AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ZEPTOMAIL_API_KEY=
ZEPTOMAIL_SENDER=

LLM_PROVIDER=kimi
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
LLM_ENDPOINT=

CORS_ORIGINS=["http://localhost:3000"]
